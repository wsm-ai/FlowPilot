# Required. Use a real DeepSeek API key only in your local runtime environment.
DEEPSEEK_API_KEY=your_api_key_here

# Optional DeepSeek settings. These values match the application defaults.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional MCP server configuration as a JSON array. Empty disables MCP servers.
MCP_SERVERS=[]

# Inbound FlowPilot API authentication. Keep enabled outside explicit local tests.
FLOWPILOT_AUTH_ENABLED=true
FLOWPILOT_API_KEY=replace_with_a_strong_random_api_key
# Optional additional role-bound keys. The legacy key above remains admin.
FLOWPILOT_API_KEYS=[]
